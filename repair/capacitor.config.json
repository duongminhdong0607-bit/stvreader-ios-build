{
  "appId": "com.stvreader.capacitor.rebuild",
  "appName": "STV MobileReader - Fixed",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "server": {
    "hostname": "sangtacviet.com",
    "iosScheme": "capacitor",
    "url": "https://sangtacviet.com/app.v2.php",
    "allowNavigation": [
      "sangtacviet.com",
      "*.sangtacviet.com"
    ]
  }
}
